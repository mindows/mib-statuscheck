{
  "schemaVersion": 1,
  "id": "mib-statuscheck",
  "name": "MIB Status Check",
  "version": "2.0.0",
  "author": "min",
  "license": "MIT",
  "description": "Watches any number of Atlassian Statuspage services (Claude, GitHub, Cloudflare, ...), notifies when one changes, and lists ongoing incidents in a bar popup.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "MIB Status Check",
    "description": "Multi-service status with change notifications, an ongoing-incident popup, and an in-panel settings view.",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 300,
      "notify": true,
      "hideWhenOperational": false,
      "services": [
        {
          "name": "Claude",
          "url": "https://status.claude.com"
        }
      ]
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Check interval (seconds)",
        "min": 60,
        "max": 21600,
        "step": 60,
        "defaultValue": 300
      },
      {
        "key": "notify",
        "type": "boolean",
        "label": "Notify on status change",
        "defaultValue": true
      },
      {
        "key": "hideWhenOperational",
        "type": "boolean",
        "label": "Only show the icon when something is wrong",
        "defaultValue": false
      }
    ]
  }
}
